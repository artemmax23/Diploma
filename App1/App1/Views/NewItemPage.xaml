<?xml version="1.0" encoding="UTF-8"?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="App1.Views.NewItemPage"
             Shell.PresentationMode="ModalAnimated"
             Title="Новая книга"
             xmlns:ios="clr-namespace:Xamarin.Forms.PlatformConfiguration.iOSSpecific;assembly=Xamarin.Forms.Core"
             ios:Page.UseSafeArea="true">
    <ContentPage.Content>
        <StackLayout Spacing="3" Padding="15" BackgroundColor="White">
            <Label Text="Название" FontSize="Medium" TextColor="Black"/>
            <Entry Text="{Binding Text, Mode=TwoWay}" FontSize="Medium" TextColor="Black"/>
            <Label Text="Автор" FontSize="Medium" TextColor="Black"/>
            <Entry Text="{Binding Author, Mode=TwoWay}" FontSize="Medium" Margin="0" TextColor="Black"/>
            <Label Text="Комментарии" FontSize="Medium" TextColor="Black"/>
            <Editor Text="{Binding Comment, Mode=TwoWay}" AutoSize="TextChanges" FontSize="Medium" Margin="0" TextColor="Black" />
            <StackLayout Orientation="Horizontal">
                <Button Text="Отмена" Command="{Binding CancelCommand}" HorizontalOptions="FillAndExpand"></Button>
                <Button Text="Добавить" Command="{Binding SaveCommand}" HorizontalOptions="FillAndExpand"></Button>
            </StackLayout>
        </StackLayout>
    </ContentPage.Content>
    
</ContentPage>
